# Scripts must stay LF: Git-bash on the Windows runner chokes on CRLF shell scripts.
*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
# Client case data and Fortran source: never convert line endings on any platform.
cases/** -text
corpus/** -text
src/**   -text
example/** -text
# Client solver binaries and the runner: never convert.
*.exe binary
